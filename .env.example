# ---------------------------------------------------------------------------
# AI-Driven 3D Blueprint Generator - environment configuration
# Copy to .env and edit. NEVER commit .env - it is gitignored.
# ---------------------------------------------------------------------------

# --- server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- storage (defaults to ./storage) ---
# STORAGE_DIR=./storage
# DATABASE_URL=sqlite:///./storage/projects.db
# For PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/blueprints

# --- provider selection ---
# image_provider:  diffusers | openai | stability
# threed_provider: auto | visual_hull | triposr | shap_e | trellis_api | text2voxel
#   auto        - best available: triposr, then shap_e, then visual_hull; when
#                 no image provider can run (and there are no views), falls back
#                 to text2voxel if its model files are installed
#   visual_hull - carves the generated views; faithful but blind to concavities
#   triposr     - learned single-image 3D; sharpest and fastest (needs
  #                 scripts/install_triposr.py)
#   shap_e      - learned single-image 3D; recovers object-like structure
#   text2voxel  - Text2Voxel-64: text straight to a coloured 64^3 shape on the
#                 CPU, no views and no GPU (needs scripts/install_text2voxel.py)
IMAGE_PROVIDER=diffusers
THREED_PROVIDER=auto

# --- local Stable Diffusion ---
# sd-turbo is fast and fits in ~4 GB VRAM. For more detail on a bigger GPU try
# stabilityai/sdxl-turbo or stabilityai/stable-diffusion-2-1.
DIFFUSERS_MODEL=stabilityai/sd-turbo
DIFFUSERS_DEVICE=auto
DIFFUSERS_STEPS=4
DIFFUSERS_GUIDANCE=0.0
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# --- hosted image providers (leave blank to disable) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=
STABILITY_MODEL=stable-image/generate/core

# --- local learned image-to-3D (TripoSR, ~1.7 GB; run scripts/install_triposr.py) ---
# TRIPOSR_PATH=./backend/vendor/TripoSR
TRIPOSR_RESOLUTION=256

# --- local learned image-to-3D (Shap-E, ~1.3 GB on first use) ---
SHAP_E_STEPS=64
SHAP_E_GUIDANCE=3.0

# --- local text-to-3D (Text2Voxel-64, ~55 MB; run scripts/install_text2voxel.py) ---
# A relative path is resolved from the repository root.
# TEXT2VOXEL_PATH=backend/models/text2voxel
# Leave these unset to use the values the model was trained with (meta.json:
# 50 DDIM steps, guidance 3.0). Fewer steps are faster and rougher.
# TEXT2VOXEL_STEPS=50
# TEXT2VOXEL_GUIDANCE=3.0

# --- hosted image-to-3D endpoint (TRELLIS / SLAT-compatible, experimental) ---
TRELLIS_ENDPOINT=
TRELLIS_API_KEY=

# --- CAD tools (auto-detected when blank) ---
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# FREECAD_PATH=C:\Program Files\FreeCAD 1.0\bin\FreeCADCmd.exe
BLENDER_TIMEOUT=300

# --- reconstruction ---
VOXEL_RESOLUTION=128
MAX_UPLOAD_BYTES=26214400
JOB_TIMEOUT=1800
